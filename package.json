{
  "name": "sgad",
  "version": "0.3.0",
  "description": "Spec-Governed Agentic Development: AI development governance framework and runnable comparison experiment.",
  "type": "module",
  "bin": {
    "sgad": "./bin/sgad.js"
  },
  "scripts": {
    "sgad": "node bin/sgad.js",
    "test": "node --test test/sgad-check.test.js test/sgad-experience.test.js test/sgad-ci.test.js test/agent-replay.test.js",
    "evaluate": "node tools/evaluate-all.js",
    "evaluate:replay": "node tools/agent-replay.js --json --min-pass-rate 1",
    "evaluate:saas": "node tools/evaluate-saas-page.js",
    "check": "npm test && node tools/agent-replay.js --min-pass-rate 1 && node bin/sgad.js check && node bin/sgad.js experience audit && node tools/evaluate-all.js --min-score 95 --min-framework-score 98",
    "test:openspec": "cd variants/openspec && node --test",
    "test:superpowers": "cd variants/superpowers && node --test",
    "test:sgad": "cd variants/sgad && node --test"
  },
  "keywords": [
    "ai",
    "agent",
    "governance",
    "sdd",
    "spec-driven-development",
    "context-engineering",
    "tdd"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/MadPrinter/sgad.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  }
}
